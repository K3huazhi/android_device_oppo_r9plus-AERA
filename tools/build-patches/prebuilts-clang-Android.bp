// Minimal AOSP clang prebuilt module set for AERA.
//
// AERA's build/soong fork does not register the llvm_prebuilt_library_*
// module types used by the upstream clang Android.bp.  Recovery only needs
// libc++, the unwinder, builtins and the minimal UBSan runtime, so this file
// exposes those files through the standard cc_prebuilt_* types.

cc_prebuilt_library_shared {
    name: "libc++",
    host_supported: true,
    device_supported: true,
    recovery_available: true,
    vendor_available: true,
    product_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    sdk_version: "minimum",
    apex_available: ["//apex_available:platform", "//apex_available:anyapex"],
    stl: "none",
    strip: {
        none: true,
    },
    check_elf_files: false,
    export_include_dirs: ["clang-r547379/include/c++/v1"],
    target: {
        android_arm64: {
            srcs: ["clang-r547379/android_libc++/platform/aarch64/lib/libc++.so"],
        },
        android_arm: {
            srcs: ["clang-r547379/android_libc++/platform/arm/lib/libc++.so"],
        },
        android_x86_64: {
            srcs: ["clang-r547379/android_libc++/platform/x86_64/lib/libc++.so"],
        },
        android_x86: {
            srcs: ["clang-r547379/android_libc++/platform/i386/lib/libc++.so"],
        },
        linux_glibc: {
            srcs: ["clang-r547379/lib/libc++.so"],
        },
        linux_musl: {
            srcs: ["clang-r547379/musl/lib/x86_64-unknown-linux-musl/libc++.so"],
        },
    },
}

